   "source": [
    "## 12. Interactive HR Policy Chatbot\n",
    "\n",
    "The following loop allows users to interact with the RAG system continuously.\n",
    "\n",
    "Type `exit` to stop the chatbot."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 71,
   "id": "3f31a860-10f1-436a-9473-cdc4d554d61d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "\n",
      "You:  How many cascual leaves can an employee take?\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Bot: An employee can take 12 casual leaves in a calendar year.\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "\n",
      "You:  exit\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Chatbot: Goodbye! 👋\n"
     ]
    }
   ],
   "source": [
    "while True:\n",
    "    query = input(\"\\nYou: \")\n",
    "\n",
    "    if query.lower() == \"exit\":\n",
    "        print(\"Chatbot: Goodbye! 👋\")\n",
    "        break\n",
    "\n",
    "    answer = ask_hr(query)\n",
    "\n",
    "    print(\"Bot:\", answer)"
   ]
