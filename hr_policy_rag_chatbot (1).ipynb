     ]
    }
   ],
   "source": [
    "response = ollama.generate(\n",
    "    model=\"llama3.2:3b\",\n",
    "    prompt=prompt\n",
    ")\n",
    "\n",
    "print(response[\"response\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f79e955d-220f-4d96-bc6d-dd5c5613103f",
   "metadata": {},
   "source": [
    "## 10. Build the Complete RAG Function\n",
    "\n",
    "The retrieval and generation steps are combined into one reusable function.\n",
    "\n",
    "The function takes a user's question and returns an answer based on the retrieved HR policy context."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "274ada54-1c3f-4e77-b8f4-6e93a876df8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_hr(query):\n",
    "    # Convert the user's question into an embedding\n",
    "    query_embedding = model.encode([query])\n",
    "\n",
    "    # Retrieve the top 2 most relevant chunks\n",
    "    distances, indices = index.search(query_embedding, k=2)\n",
    "\n",
    "    # Get the actual text of the retrieved chunks\n",
    "    retrieved_chunks = [chunks[i] for i in indices[0]]\n",
    "\n",
    "    # Combine retrieved chunks into one context\n",
    "    context = \"\\n\\n\".join(retrieved_chunks)\n",
    "\n",
    "    # Create the RAG prompt\n",
    "    prompt = f\"\"\"\n",
    "You are an HR policy assistant.\n",
    "\n",
    "Answer the user's question using ONLY the provided context.\n",
    "\n",
    "Rules:\n",
    "- Do not make assumptions.\n",
    "- Do not add information that is not explicitly stated in the context.\n",
    "- If the context does not directly answer the question, say:\n",
    "  \"I don't know based on the provided HR policy.\"\n",
    "\n",
    "Context:\n",
    "{context}\n",
    "\n",
    "Question:\n",
    "{query}\n",
    "\n",
    "Answer:\n",
    "\"\"\"\n",
    "\n",
    "    # Generate answer using Ollama\n",
    "    response = ollama.generate(\n",
    "        model=\"llama3.2:3b\",\n",
    "        prompt=prompt\n",
    "    )\n",
    "\n",
    "    # Extract the generated answer\n",
    "    answer = response[\"response\"]\n",
    "\n",
    "    return answer"
   ]
  },
