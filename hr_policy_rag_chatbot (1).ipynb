   "source": [
    "## 4. Text Chunking\n",
    "\n",
    "The HR policy document is divided into smaller chunks so that relevant sections can be retrieved efficiently."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "2519188e-d05d-4e16-81ba-554c5a43967e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_chunks(text, chunk_size=500, overlap=100):\n",
    "    chunks = []\n",
    "\n",
    "    start = 0\n",
    "\n",
    "    while start < len(text):\n",
    "        end = start + chunk_size\n",
    "        chunk = text[start:end]\n",
    "\n",
    "        chunks.append(chunk)\n",
    "\n",
    "        start = end - overlap\n",
    "\n",
    "    return chunks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "f965c00f-e40f-4ab7-bbc9-050fe7917780",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of chunks: 6\n"
     ]
    }
   ],
   "source": [
    "chunks = create_chunks(full_text)\n",
    "\n",
    "print(\"Number of chunks:\", len(chunks))"
   ]
  },
